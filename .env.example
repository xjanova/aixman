# ===========================================
# AIXMAN - AI Generation Platform
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_XMAN_URL=https://xman4289.com
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Database (shared with xmanstudio)
DATABASE_URL="mysql://user:password@localhost:3306/xmanstudio"

# Encryption key for API keys in database (must be at least 32 characters)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# Webhook secret shared with xmanstudio for credit purchases, and for the
# GPUxMINE node push (POST /api/gpux/nodes). Must equal xmanstudio's
# AIXMAN_WEBHOOK_SECRET.
XMAN_WEBHOOK_SECRET=your-webhook-secret-here

# ===========================================
# GPUxMINE community pool (home PCs sharing their GPU)
# The relay the nodes dial into. Must be the same base URL as xmanstudio's
# GPUXMINE_RELAY_URL, character for character (including :8443): xmanstudio
# builds each node's endpoint ({relay}/w/{workerId}) from it. aixman only
# reads it for the admin list and GET /api/admin/gpu/community/health — the
# pool itself needs no relay admin key (the relay key in Admin -> GPU is
# optional and only adds a live "who is connected" view).
# ===========================================
GPUXMINE_RELAY_URL=https://relay.xman4289.com:8443
# A community-only model (sdxl-community) is never rented for. A job queued
# for it that no GPUxMINE machine takes within this many minutes is refunded
# (1..120, default 5). The minutes count from when the last machine for it
# stopped taking work, not from when the order was placed.
GPUXMINE_COMMUNITY_QUEUE_GRACE_MIN=5
# How many days back the earnings sweep writes a delivered community job's
# gpu_job_earnings row that could not be written at delivery (1..90, default
# 30). xmanstudio's 2026_09_25_* migrations must run within this window of
# this build going live, or the owners of jobs delivered before them are
# never paid (a critical alert names jobs 24 h before they leave it).
GPUXMINE_EARNINGS_SWEEP_DAYS=30

# Secret for the cron endpoint that resets account-pool usage counters
# Schedule daily: curl -H "Authorization: Bearer $CRON_SECRET" <app>/api/cron/reset-counters
CRON_SECRET=your-cron-secret-here

# ===========================================
# Cloudflare R2 storage (durable storage for generated images/videos)
# Provider URLs expire, so generated assets are persisted to R2. Leave blank to
# disable (assets then keep their original provider URL / base64 — no durability).
# Create an R2 bucket + an R2 API token (Object Read & Write) in the Cloudflare
# dashboard, then enable Public Access (r2.dev) or attach a custom domain.
# ===========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aixman-generations
# Public base URL of the bucket (no trailing slash), e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# Folder this app owns when the bucket is shared with another app (production
# shares Thaiprompt's). Only keys under it are ever written or deleted.
R2_KEY_PREFIX=

# ===========================================
# AI Provider API Keys (configured via admin panel)
# These are fallbacks if not set in database
# ===========================================

# BytePlus (Seedream / Seedance)
BYTEPLUS_API_KEY=
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# OpenAI (GPT Image / DALL-E / Sora)
OPENAI_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# fal.ai
FAL_API_KEY=

# Stability AI
STABILITY_API_KEY=

# Runway ML
RUNWAY_API_SECRET=

# Kling AI
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# Luma AI
LUMA_API_KEY=

# Leonardo.ai
LEONARDO_API_KEY=

# "Sign in with XMAN ID" for the X-DREAMER mobile app.
# Must match XDREAMER_SSO_SECRET in xmanstudio — this is what proves to
# xman4289.com that a redemption came from here. Absent, the endpoint 503s.
XMAN_SSO_SECRET=
